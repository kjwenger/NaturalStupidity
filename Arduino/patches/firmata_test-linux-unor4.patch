+//------------------------------------------------------------------------------
+// MatrixFrame
+//------------------------------------------------------------------------------
+
+MatrixFrame::MatrixFrame(MyFrame *owner, int cols, int rows) :
+    wxFrame(owner, -1, "LED Matrix", wxDefaultPosition, wxDefaultSize,
+      wxDEFAULT_FRAME_STYLE | wxFRAME_FLOAT_ON_PARENT),
+    owner(owner), cols(cols), rows(rows)
+{
+	wxPanel *panel = new wxPanel(this);
+	wxBoxSizer *top = new wxBoxSizer(wxVERTICAL);
+	wxGridSizer *grid = new wxGridSizer(rows, cols, 2, 2);
+	for (int i=0; i < cols * rows; i++) {
+		wxToggleButton *led = new wxToggleButton(panel, -1, "",
+		  wxDefaultPosition, wxSize(28, 28));
+		led->SetToolTip(wxString::Format("LED %d (row %d, column %d)",
+		  i, i / cols, i % cols));
+		led->Bind(wxEVT_TOGGLEBUTTON, &MatrixFrame::OnLed, this);
+		leds.push_back(led);
+		grid->Add(led, 0, wxEXPAND);
+	}
+	top->Add(grid, 1, wxEXPAND | wxALL, 6);
+	wxBoxSizer *buttons = new wxBoxSizer(wxHORIZONTAL);
+	wxButton *clear = new wxButton(panel, -1, "Clear");
+	wxButton *all = new wxButton(panel, -1, "All on");
+	wxButton *invert = new wxButton(panel, -1, "Invert");
+	clear->Bind(wxEVT_BUTTON, [this](wxCommandEvent &) { OnFill(false, false); });
+	all->Bind(wxEVT_BUTTON, [this](wxCommandEvent &) { OnFill(true, false); });
+	invert->Bind(wxEVT_BUTTON, [this](wxCommandEvent &) { OnFill(false, true); });
+	buttons->Add(clear, 0, wxRIGHT, 4);
+	buttons->Add(all, 0, wxRIGHT, 4);
+	buttons->Add(invert, 0);
+	top->Add(buttons, 0, wxALIGN_CENTER | wxBOTTOM, 6);
+	panel->SetSizer(top);
+	top->SetSizeHints(this);
+	Bind(wxEVT_CLOSE_WINDOW, &MatrixFrame::OnClose, this);
+}
+
+void MatrixFrame::SetLed(int i, bool on)
+{
+	leds[i]->SetValue(on);
+	leds[i]->SetLabel(on ? wxString::FromUTF8("\u25CF") : wxString(""));
+}
+
+// packed: one bit per LED, 7 per byte (LED i = byte i/7, bit i%7)
+void MatrixFrame::SetLeds(const uint8_t *packed)
+{
+	for (int i=0; i < cols * rows; i++) {
+		SetLed(i, packed[i / 7] & (1 << (i % 7)));
+	}
+}
+
+void MatrixFrame::SendFrame(void)
+{
+	uint8_t buf[4 + 128] = {START_SYSEX, LED_MATRIX_DATA, LED_MATRIX_SET_FRAME};
+	int len = 3, packed = (cols * rows + 6) / 7;
+	for (int b=0; b < packed; b++) {
+		uint8_t byte = 0;
+		for (int bit=0; bit < 7 && b * 7 + bit < cols * rows; bit++) {
+			if (leds[b * 7 + bit]->GetValue()) byte |= 1 << bit;
+		}
+		buf[len++] = byte;
+	}
+	buf[len++] = END_SYSEX;
+	owner->Send(buf, len);
+}
+
+void MatrixFrame::OnLed(wxCommandEvent &event)
+{
+	for (int i=0; i < cols * rows; i++) {
+		if (leds[i] != event.GetEventObject()) continue;
+		bool on = leds[i]->GetValue();
+		SetLed(i, on);
+		uint8_t buf[6] = {START_SYSEX, LED_MATRIX_DATA, LED_MATRIX_SET_PIXEL,
+		  (uint8_t)i, (uint8_t)on, END_SYSEX};
+		owner->Send(buf, 6);
+		return;
+	}
+}
+
+void MatrixFrame::OnFill(bool on, bool invert)
+{
+	for (int i=0; i < cols * rows; i++) {
+		SetLed(i, invert ? !leds[i]->GetValue() : on);
+	}
+	SendFrame();
+}
+
+// Closing only hides the window; View > LED Matrix brings it back
+void MatrixFrame::OnClose(wxCloseEvent &event)
+{
+	if (event.CanVeto()) {
+		event.Veto();
+		Hide();
+	} else {
+		event.Skip();
+	}
+}
